{
  "name": "agent-research-network",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "cd packages/database && npm run migrate",
    "db:migrate:create": "cd packages/database && npm run migrate:create",
    "api": "cd apps/api && npm run dev",
    "web": "cd apps/web && npm run dev",
    "mcp": "cd apps/mcp-server && npm run dev"
  },
  "devDependencies": {
    "turbo": "^2.0.12",
    "typescript": "^5.5.4",
    "dotenv": "^16.4.5"
  }
}
