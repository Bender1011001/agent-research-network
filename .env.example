# Database
# For local dev: postgresql://arn:arn_dev_password@localhost:5432/agent_research_network
# For production: Use managed Postgres URL from Railway/Render
DATABASE_URL=postgresql://arn:arn_dev_password@localhost:5432/agent_research_network

# Legacy individual DB config (still supported)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_research_network
DB_USER=arn
DB_PASSWORD=arn_dev_password

# API Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# URLs (for CORS, OAuth redirects, MCP discovery)
# In production, set these to your Railway/Render domains
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Security
# REQUIRED in production: Generate with `openssl rand -hex 32`
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_32
SESSION_SECRET=change_me_in_production_use_openssl_rand_hex_32

# Migrations
# Set to "false" to skip migrations on container boot (not recommended)
RUN_MIGRATIONS=true

# Demo Data
# IMPORTANT: Set to "false" in production (or omit entirely)
# Only enable for development/testing environments
# When true, allows running scripts/seed-demo.ts with demo user/password
ALLOW_DEMO_SEED=true

# Artifact Storage
# For local dev: filesystem
# For production: Configure S3-compatible object storage
ARTIFACT_STORAGE_ROOT=./storage/artifacts
ARTIFACT_STORAGE_TYPE=filesystem

# S3/MinIO Object Storage (Production)
# Required if ARTIFACT_STORAGE_TYPE=s3
# S3_BUCKET=agent-research-network
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key

# MinIO (Local Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=arn_minio
MINIO_SECRET_KEY=arn_minio_password
MINIO_BUCKET=artifacts

# CORS Origins (comma-separated)
# In production, restrict to your domains
# CORS_ORIGINS=https://your-app.railway.app,https://your-app.onrender.com

# Node Environment
NODE_ENV=development

# Next.js
NEXT_TELEMETRY_DISABLED=1
